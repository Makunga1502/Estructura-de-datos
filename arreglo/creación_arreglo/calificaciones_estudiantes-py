# Lista de calificaciones de estudiante
calificaciones = [85, 90, 78, 92, 88]

#consulta una califificación específica
indice = int(input("Ingrese el índice de la calificación que desea modificar (0-4): "))
print(f"calificiación en la posicion {indice}: {calificaciones[indice]}")

#se modifica la calificación en el índice especificado
nuevo_valor = float(input("Ingrese la nueva calificación: "))
calificaciones[indice] = nuevo_valor
print("Calificaciones actualizadas")
print("Calificaciones actualizadas:", calificaciones)

#calcula el promedio de las calificaciones
promedio = sum(calificaciones) / len(calificaciones)
print(f"el promedio de las calificaciones es: {promedio}")